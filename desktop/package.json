{
  "name": "ba-mate-desktop",
  "version": "0.4.0",
  "private": true,
  "description": "BA Mate local research pilot",
  "author": "BA Mate research project",
  "main": "main.cjs",
  "scripts": {"start": "electron .", "package": "electron-builder --dir", "dist": "electron-builder"},
  "devDependencies": {"electron": "44.3.0", "electron-builder": "26.15.3"},
  "build": {
    "appId": "research.bamate.desktop",
    "productName": "BA Mate",
    "directories": {"output": "../release"},
    "files": ["main.cjs", "preload.cjs", "package.json"],
    "extraResources": [{"from": "../frontend/dist", "to": "frontend"}, {"from": "../build/service/ba-mate-service", "to": "service"}],
    "mac": {"category": "public.app-category.productivity", "target": ["zip"], "identity": null},
    "win": {"target": ["nsis"]},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true},
    "linux": {"target": ["AppImage"], "category": "Office"}
  }
}
